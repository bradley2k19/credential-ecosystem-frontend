# Base URL of the backend API (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Address of the deployed CertificateRegistry contract on Polygon Amoy.
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Public URL of this frontend (no trailing slash). QR codes and shared verification links are built from it,
# so set it to the deployed site, never localhost, or printed QR codes will not open on other devices.
# If unset, the origin of the page the student is viewing is used.
NEXT_PUBLIC_APP_URL=https://your-frontend.vercel.app
